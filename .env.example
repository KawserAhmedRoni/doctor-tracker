# Environment Variables Configuration
# Copy this file to .env.local and populate the values below

# -----------------------------------------------------------------------------
# Database Configuration (MongoDB Atlas)
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/doctor-tracker?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# Authentication Configuration (NextAuth.js)
# -----------------------------------------------------------------------------
# Generate a secure 32-byte secret via OpenSSL: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_key_here
NEXTAUTH_URL=http://localhost:3000
